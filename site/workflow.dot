digraph Workflow {
  graph [rankdir=TB, bgcolor="#f7fafc", pad=0.4, nodesep=0.35, ranksep=0.6, fontname="Helvetica", fontsize=24, labelloc=t, label="Breast Screening Follow-up Agent\nRules read and decide · Claude helps with judgment · People make the clinical calls"];
  node [shape=box, style="rounded,filled", fillcolor="#d9f2ee", color="#319a8c", fontcolor="#163449", fontname="Helvetica", fontsize=12, margin="0.15,0.12"];
  edge [color="#607b8c", fontname="Helvetica", fontsize=10, arrowsize=0.7];
  subgraph cluster_report {
    label="1 · Report and pathway"; fontsize=18; color="#bad4df"; style=rounded;
    arrival [label="New imaging report / addendum"];
    read [label="Rules read BI-RADS, exam date, breast\nand recommendation, with exact words\n(each breast on its own when assessed separately)"];
    checks [shape=diamond, label="Read cleanly?\nOne category per breast; valid date;\nfindings agree with impression"];
    review [label="Radiologist review\nHold until corrected report", fillcolor="#ffedc2", color="#cc9a37"];
    category [shape=diamond, label="BI-RADS?"];
    routine [label="1–2: Close case\nRoutine screening", fillcolor="#e0efce", color="#7b9e4c"];
    diagnostic [label="0: Diagnostic imaging\nDue 14 days after exam"];
    short [label="3: Imaging due in 6 months\nReminders start 1 month before due\nStable repeat: close current follow-up;\nnext imaging in 6 months"];
    biopsy [label="4–5: Biopsy due in 14 days\nNotify ordering PCP\nFor 5: immediate navigator heads-up"];
    arrival -> read -> checks;
    checks -> review [label="No"];
    review -> read [label="Correction", constraint=false];
    checks -> category [label="Yes"];
    category -> routine [label="1–2"];
    category -> diagnostic [label="0"];
    category -> short [label="3"];
    category -> biopsy [label="4–5"];
    category -> review [label="Unsupported"];
  }
  subgraph cluster_outreach {
    label="2 · Outreach, booking and appointment"; fontsize=18; color="#bad4df"; style=rounded;
    outreach [label="Send booking invitation\nText → portal → call"];
    booking [shape=diamond, label="Booking confirmed\nin schedule?"];
    reply [shape=diamond, label="Patient replied?"];
    readreply [label="Claude labels reply\nCode verifies supporting quote", fillcolor="#dceafb", color="#5687c5"];
    meaning [shape=diamond, label="Reply outcome?"];
    support [label="Ride / different time:\nOffer ride or alternative slots"];
    saysbooked [label="Says booked:\nCheck scheduling system"];
    escalation [shape=diamond, label="Escalation threshold\nreached?"];
    navigator [label="Nurse navigator takes over\nMay help arrange booking", fillcolor="#ffedc2", color="#cc9a37"];
    reminder [label="Reminder 1 day before appointment"];
    appt [shape=diamond, label="Procedure completed\n(simulated attendance)"];
    newreport [label="New imaging report"];
    timing [shape=note, fillcolor="#ffffff", color="#bad4df", label="Urgent: text day 0, portal day 2, call day 4.\nNo response after 3 attempts: navigator day 5.\nReplies but unbooked: check-in every 3 days.\nUnbooked: biopsy day 7; diagnostic day 30 after exam.\nBI-RADS 3: reminders start 1 month before due;\ntext, portal +7 days, call +14 days; further reminders\nat due −7, due, due +14 days if unanswered.\nIf replied: check-in every 7 days.\nNavigator at 1 month overdue."];
    outreach -> booking;
    booking -> reminder [label="Yes"];
    booking -> reply [label="No"];
    reply -> readreply [label="Yes"];
    readreply -> meaning;
    meaning -> support [label="Practical help"];
    meaning -> saysbooked [label="Booking claim"];
    meaning -> navigator [label="Fear / medical question / refusal /\nother barrier / wrong number /\ninvalid quote / unclear reply"];
    support -> booking [constraint=false];
    saysbooked -> booking [constraint=false];
    reply -> escalation [label="No"];
    escalation -> outreach [label="No: continue reminders", constraint=false];
    escalation -> navigator [label="Yes"];
    navigator -> booking [label="Booking arranged", constraint=false];
    reminder -> appt;
    appt -> newreport [label="Imaging"];
    outreach -> timing [style=dotted, arrowhead=none];
  }
  diagnostic -> outreach;
  short -> outreach [label="When reminders start"];
  biopsy -> outreach;
  newreport -> read [label="Re-enter report checks", constraint=false];
  subgraph cluster_pathology {
    label="3 · Pathology and resolution"; fontsize=18; color="#bad4df"; style=rounded;
    wait [label="Watch for pathology\nDue 10 days after biopsy"];
    received [shape=diamond, label="Result received?"];
    missing [label="If missing at day 10:\nNavigator investigates", fillcolor="#ffedc2", color="#cc9a37"];
    pathread [label="Rules read the diagnosis:\ncancer, atypia, benign or nondiagnostic"];
    pathcheck [shape=diamond, label="Read cleanly?"];
    compare [label="Claude compares pathology with imaging\nSide-by-side summary; flags possible mismatch\nCode checks every quote", fillcolor="#dceafb", color="#5687c5"];
    pathreview [label="Radiologist review / correction", fillcolor="#ffedc2", color="#cc9a37"];
    result [shape=diamond, label="Pathology result?"];
    malignant [label="Malignant: notify PCP\nHand off to breast surgery", fillcolor="#ffedc2", color="#cc9a37"];
    done [label="Close agent's follow-up loop", fillcolor="#e0efce", color="#7b9e4c"];
    benign [label="Benign: radiologist decides\nwhether it matches the imaging", fillcolor="#ffedc2", color="#cc9a37"];
    repeat [label="Doesn't match: notify PCP\nRepeat biopsy due in 14 days\nAgent restarts outreach"];
    resolved [label="If concordant: close case\nReturn to annual screening", fillcolor="#e0efce", color="#7b9e4c"];
    other [label="Atypia / nondiagnostic / other:\nRadiologist decides next step", fillcolor="#ffedc2", color="#cc9a37"];
    wait -> received;
    received -> missing [label="No"];
    missing -> pathread [label="Result arrives"];
    received -> pathread [label="Yes"];
    pathread -> pathcheck;
    pathcheck -> pathreview [label="No"];
    pathreview -> pathread [label="Correction", constraint=false];
    pathcheck -> compare [label="Yes"];
    compare -> result;
    result -> malignant [label="Malignant"];
    malignant -> done;
    result -> benign [label="Benign"];
    benign -> resolved [label="Matches"];
    benign -> repeat [label="Doesn't match"];
    result -> other [label="Other"];
  }
  appt -> wait [label="Biopsy"];
  repeat -> outreach [label="Book repeat biopsy", constraint=false];
  navigator -> wait [style=invis];
  support -> wait [style=invis];
  saysbooked -> wait [style=invis];
  newreport -> wait [style=invis];
  footer [shape=plaintext, fillcolor="#f7fafc", label="Synthetic demo · Not for clinical use\nNo real messages, bookings or EHR writes. No-show / rebooking flows are future work.\n60-day resolution is reported for the abnormal-result cohort, not a separate escalation trigger."];
  done -> footer [style=invis];
  resolved -> footer [style=invis];
  other -> footer [style=invis];
}
