# Copy to .env for local development; never commit credentials.
# Recorded mode needs no key; it recognizes the bundled samples only.
READER_MODE=recorded
ANTHROPIC_API_KEY=
# Optional. When blank, the reader discovers an available Sonnet model via /v1/models.
ANTHROPIC_MODEL=
HOST=127.0.0.1
PORT=3000
CASE_DB_PATH=.local/cases.sqlite
APP_TIME_ZONE=America/New_York
