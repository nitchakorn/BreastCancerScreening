# Copy to .env for local development; never commit credentials.
# READER_MODE:
#   recorded     no key; Claude's recorded reads of the bundled samples only
#   claude-code  live reads through the claude command and your Claude Code sign-in; no API key
#   live         live reads through the Claude API; needs ANTHROPIC_API_KEY
READER_MODE=recorded
# Optional for claude-code mode: the full path of the claude program, if `claude` is not on PATH.
CLAUDE_CODE_COMMAND=
ANTHROPIC_API_KEY=
# Optional. When blank, the reader discovers an available Sonnet model via /v1/models.
ANTHROPIC_MODEL=
HOST=127.0.0.1
PORT=3000
CASE_DB_PATH=.local/cases.sqlite
APP_TIME_ZONE=America/New_York
